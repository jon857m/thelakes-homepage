{
  "name": "thelakesincumbria-site",
  "private": true,
  "type": "module",
  "scripts": {
    "map:dev": "vite --config map-app/vite.config.ts",
    "map:build": "tsc -p map-app/tsconfig.json && vite build --config map-app/vite.config.ts && node tools/build_static_map_routes.mjs",
    "map:lint": "eslint --config map-app/eslint.config.js map-app/src --max-warnings=0",
    "map:check": "npm run map:lint && npm run map:build"
  },
  "dependencies": {
    "@maptiler/sdk": "^4.1.0",
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "supabase": "^2.115.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4"
  }
}
